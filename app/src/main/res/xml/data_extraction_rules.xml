<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="localllm_prefs.xml" />
        <include domain="sharedpref" path="localllm_presets.xml" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="localllm_prefs.xml" />
        <include domain="sharedpref" path="localllm_presets.xml" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
